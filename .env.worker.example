# ── 本機 worker 設定（複製成 .env.worker 後填寫，.env.worker 不要 commit）──

# Railway 上 bot 的網址（結尾不要加斜線）
BOT_URL=https://你的服務.up.railway.app

# 與 Railway 環境變數 BROWSER_WORKER_TOKEN 相同的密鑰，自己隨機產生一串長字元
BROWSER_WORKER_TOKEN=

# cookie 種子：**通常不需要填**。建議改用一次性登入（雙擊 login_threads.bat），
# 登入狀態會留在 worker 專用的 Chrome profile 裡，之後由瀏覽器自己維護。
# 只有在你想用既有 session 當種子時才填（Cookie-Editor 匯出的整包 JSON 壓成一行）。
THREADS_COOKIES=

# 這台機器的名字（顯示在 Telegram 狀態裡），留空則自動用電腦名稱
WORKER_NAME=

# 幾秒問一次 Railway 有沒有工作
WORKER_POLL_SECONDS=30

# 平常背景跑（1）。若 session 還是一直被殺，可以改 0 試有頭瀏覽器
SCRAPER_HEADLESS=1

# worker 專用的 Chrome profile 目錄（留空則每次都用臨時 context）
# 不要指向你平常在用的 Chrome profile —— Chrome 開著會鎖住它
# BROWSER_USER_DATA_DIR=

# 用真實 Chrome（chrome）而不是 Chromium；找不到會自動退回
BROWSER_CHANNEL=chrome

# 預期的 Threads 帳號（insurance_vision_ 的 ds_user_id）。登入到別的帳號會被擋下來。
EXPECTED_DS_USER_ID=27618660493
