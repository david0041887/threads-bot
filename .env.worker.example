# ── 本機 worker 設定（複製成 .env.worker 後填寫，.env.worker 不要 commit）──

# Railway 上 bot 的網址（結尾不要加斜線）
BOT_URL=https://你的服務.up.railway.app

# 與 Railway 環境變數 BROWSER_WORKER_TOKEN 相同的密鑰，自己隨機產生一串長字元
BROWSER_WORKER_TOKEN=

# 第一次的 cookie 種子：從已登入的 Chrome 用 Cookie-Editor 匯出 threads.com 的
# 整包 JSON，貼成一行。之後 rotate 的版本由 cookie_store 自動存進本機 state.db，
# 不需要再手動更新，除非整個 session 真的被登出。
THREADS_COOKIES=

# 這台機器的名字（顯示在 Telegram 狀態裡），留空則自動用電腦名稱
WORKER_NAME=

# 幾秒問一次 Railway 有沒有工作
WORKER_POLL_SECONDS=30

# 有頭瀏覽器（0）比較不像機器人；要讓它安靜在背景跑就改 1
SCRAPER_HEADLESS=0
